{
  "manifest_version": 3,
  "name": "Google Reviews for Wolt",
  "version": "0.1.0",
  "description": "Shows Google ratings and reviews for restaurants on wolt.com.",
  "permissions": ["storage"],
  "host_permissions": [],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://wolt.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
