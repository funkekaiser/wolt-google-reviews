{
  "manifest_version": 3,
  "name": "Rating Lens for Wolt",
  "version": "1.0.0",
  "description": "See the Google Maps rating of a restaurant while you order on wolt.com.",
  "homepage_url": "https://github.com/funkekaiser/wolt-google-reviews",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://wolt.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
