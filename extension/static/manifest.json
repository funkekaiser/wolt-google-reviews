{
  "manifest_version": 3,
  "name": "Rating Lens for Wolt",
  "version": "1.0.0",
  "description": "See Google Maps ratings and reviews next to restaurants on wolt.com.",
  "homepage_url": "https://github.com/funkekaiser/wolt-google-reviews",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wolt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
